generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===== ENUMS =====

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ClinicStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
  DELETED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum DomainType {
  PLATFORM_SUBDOMAIN
  CUSTOM_DOMAIN
}

enum DomainStatus {
  PENDING
  VERIFICATION_REQUIRED
  VERIFIED
  ACTIVE
  FAILED
  SUSPENDED
  REMOVED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
}

enum WebsiteSectionType {
  HERO
  ABOUT
  SERVICES
  DOCTORS
  WHY_CHOOSE_US
  GALLERY
  TESTIMONIALS
  FAQ
  CONTACT
  BOOKING
}

enum AuditAction {
  LOGIN
  LOGOUT
  SIGNUP
  CLINIC_CREATED
  CLINIC_UPDATED
  CLINIC_SUSPENDED
  CLINIC_REACTIVATED
  CLINIC_DELETED
  ADMIN_CLINIC_ACCESS
  ADMIN_CLINIC_EXIT
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  ROLE_CHANGED
  PASSWORD_CHANGED
  PASSWORD_RESET
  EMAIL_VERIFIED
  DOMAIN_ADDED
  DOMAIN_REMOVED
  DOMAIN_VERIFIED
  SUBSCRIPTION_CHANGED
  SETTINGS_UPDATED
  WEBSITE_UPDATED
  WEBSITE_PUBLISHED
}

// ===== USER & AUTH MODELS =====

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified Boolean    @default(false)
  phoneVerified Boolean    @default(false)
  passwordHash  String
  fullName      String
  phone         String?
  avatarUrl     String?
  isAdmin       Boolean    @default(false)
  isSuperAdmin  Boolean    @default(false)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deviceTokens  String[]   @default([])

  sessions            Session[]
  memberships         ClinicMembership[]
  doctors             Doctor[]
  auditLogs           AuditLog[]           @relation("AuditActor")
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  phoneOtps           PhoneOtp[]
  stockTransactions   StockTransaction[]

  @@index([email])
  @@index([status])
}

model Session {
  id        String   @id // SHA-256 hash of session token
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  // Admin tenant access
  adminAccessClinicId  String?
  adminAccessStartedAt DateTime?
  adminAccessExpiresAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model VerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique // SHA-256 hash
  userId    String
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique // SHA-256 hash
  userId    String
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
}

model PhoneOtp {
  id        String    @id @default(cuid())
  userId    String
  phone     String
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([phone])
}

model PendingRegistration {
  id        String   @id @default(cuid())
  phone     String
  email     String
  otpCode   String
  payload   Json     // stores the registration details temporarily
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([email])
}

// ===== CLINIC & MULTI-TENANCY =====

model Clinic {
  id        String       @id @default(cuid())
  name      String // Arabic name
  slug      String       @unique // English slug for subdomain
  status    ClinicStatus @default(ACTIVE)
  timezone  String       @default("Africa/Cairo")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  settings       ClinicSettings?
  memberships    ClinicMembership[]
  roles          Role[]             @relation("ClinicRoles")
  doctors        Doctor[]
  patients       Patient[]
  appointments   Appointment[]
  services       Service[]
  website        Website?
  domains        Domain[]
  subscription   Subscription?
  auditLogs      AuditLog[]
  mediaAssets    MediaAsset[]
  prescriptions  Prescription[]     @relation("ClinicPrescriptions")
  invoices       Invoice[]          @relation("ClinicInvoices")
  payments       Payment[]          @relation("ClinicPayments")
  expenses       Expense[]          @relation("ClinicExpenses")
  inventoryItems InventoryItem[]    @relation("ClinicInventory")
  leads          Lead[]             @relation("ClinicLeads")

  @@index([slug])
  @@index([status])
}

model ClinicSettings {
  id              String   @id @default(cuid())
  clinicId        String   @unique
  logoUrl         String?
  faviconUrl      String?
  primaryColor    String   @default("#2563EB")
  secondaryColor  String   @default("#1E40AF")
  accentColor     String   @default("#3B82F6")
  fontId          String?
  phone           String?
  email           String?
  address         String?
  city            String?
  country         String   @default("EG")
  socialFacebook  String?
  socialInstagram String?
  socialTwitter   String?
  socialWhatsapp  String?
  
  // Notification Settings
  notifyBookingConfirmation Boolean @default(true)
  notifyBookingCancellation Boolean @default(true)
  notifyVisitCompletion     Boolean @default(true)
  notifyAppointmentReminder Boolean @default(true)
  reminderHoursBefore       Int     @default(24)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  font   Font?  @relation(fields: [fontId], references: [id])
}

model ClinicMembership {
  id        String           @id @default(cuid())
  userId    String
  clinicId  String
  roleId    String
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, clinicId])
  @@index([clinicId])
  @@index([userId])
}

// ===== RBAC =====

model Role {
  id        String   @id @default(cuid())
  name      String
  nameAr    String
  clinicId  String? // null = system default role
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic      Clinic?            @relation("ClinicRoles", fields: [clinicId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships ClinicMembership[]

  @@unique([name, clinicId])
  @@index([clinicId])
}

model Permission {
  id            String  @id @default(cuid())
  key           String  @unique // e.g. "patients.view"
  description   String?
  descriptionAr String?
  category      String // e.g. "patients"

  roles RolePermission[]

  @@index([category])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ===== CLINIC BUSINESS MODELS =====

model Doctor {
  id            String   @id @default(cuid())
  clinicId      String
  userId        String?
  fullName      String
  specialty     String?
  phone         String?
  email         String?
  imageUrl      String?
  bio           String?  @db.Text
  isActive      Boolean  @default(true)
  showOnWebsite Boolean  @default(true)
  sortOrder     Int      @default(0)
  workingHours  Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clinic        Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments  Appointment[]
  services      DoctorService[]
  prescriptions Prescription[]  @relation("DoctorPrescriptions")

  @@index([clinicId])
  @@index([userId])
}

model Patient {
  id          String    @id @default(cuid())
  clinicId    String
  fullName    String
  phone       String
  email       String?
  dateOfBirth DateTime?
  gender      Gender?
  address     String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  clinic         Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments   Appointment[]
  medicalHistory MedicalHistory?
  dentalRecords  DentalRecord[]
  prescriptions  Prescription[]  @relation("PatientPrescriptions")
  invoices       Invoice[]       @relation("PatientInvoices")

  @@index([clinicId])
  @@index([clinicId, fullName])
  @@index([clinicId, phone])
}

model Service {
  id            String   @id @default(cuid())
  clinicId      String
  slug          String? // Added for website (e.g. /services/teeth-whitening)
  name          String
  nameEn        String?
  description   String?
  content       String?  @db.Text // Added for detailed service page
  price         Decimal? @db.Decimal(10, 2)
  duration      Int? // minutes
  imageUrl      String?
  isActive      Boolean  @default(true)
  showOnWebsite Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clinic       Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  doctors      DoctorService[]
  invoiceItems InvoiceItem[]

  @@index([clinicId])
  @@index([clinicId, slug])
  @@index([clinicId, isActive])
}

model DoctorService {
  doctorId  String
  serviceId String

  doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([doctorId, serviceId])
}

model Appointment {
  id        String            @id @default(cuid())
  clinicId  String
  patientId String
  doctorId  String
  serviceId String?
  date      DateTime          @db.Date
  startTime String // "09:00" format
  endTime   String? // "09:30" format
  status    AppointmentStatus @default(SCHEDULED)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  clinic        Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor        Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  service       Service?       @relation(fields: [serviceId], references: [id])
  prescriptions Prescription[]
  invoices      Invoice[]

  @@index([clinicId, date])
  @@index([clinicId, status])
  @@index([clinicId, doctorId, date])
  @@index([clinicId, patientId])
}

// ===== WEBSITE =====

model Website {
  id          String   @id @default(cuid())
  clinicId    String   @unique
  themeId     String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clinic   Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  theme    WebsiteTheme?    @relation(fields: [themeId], references: [id])
  sections WebsiteSection[]
  settings WebsiteSettings?
}

model WebsiteSection {
  id        String             @id @default(cuid())
  websiteId String
  type      WebsiteSectionType
  title     String?
  titleEn   String?
  content   Json? // Section-specific content
  isEnabled Boolean            @default(true)
  sortOrder Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, sortOrder])
}

model WebsiteTheme {
  id          String   @id @default(cuid())
  name        String
  nameAr      String
  slug        String   @unique
  description String?
  previewUrl  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  websites Website[]
}

model WebsiteSettings {
  id              String   @id @default(cuid())
  websiteId       String   @unique
  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?
  canonicalDomain String?
  customCss       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
}

// ===== DOMAINS =====

model Domain {
  id         String       @id @default(cuid())
  clinicId   String
  domain     String       @unique
  type       DomainType
  status     DomainStatus @default(PENDING)
  isPrimary  Boolean      @default(false)
  verifiedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([domain])
  @@index([clinicId])
}

// ===== MEDIA =====

model MediaAsset {
  id        String   @id @default(cuid())
  clinicId  String
  fileName  String
  fileUrl   String
  fileSize  Int
  mimeType  String
  category  String // logo, doctor, service, gallery, website
  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@index([clinicId, category])
}

// ===== SUBSCRIPTIONS =====

model Plan {
  id           String   @id @default(cuid())
  name         String
  nameAr       String
  slug         String   @unique
  description  String?
  priceMonthly Decimal? @db.Decimal(10, 2)
  priceYearly  Decimal? @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  features      PlanFeature[]
  subscriptions Subscription[]
}

model PlanFeature {
  id     String @id @default(cuid())
  planId String
  key    String // e.g. "website.custom_domain", "team.max_users"
  value  String // "true", "5", "unlimited"

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
}

model Subscription {
  id        String             @id @default(cuid())
  clinicId  String             @unique
  planId    String
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @default(now())
  endDate   DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([clinicId])
  @@index([status])
}

// ===== AUDIT =====

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  clinicId   String?
  action     AuditAction
  resource   String? // e.g. "patient", "appointment"
  resourceId String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  actor  User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  @@index([clinicId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

// ===== PLATFORM SETTINGS =====

model PlatformSettings {
  id            String   @id @default(cuid())
  platformName  String   @default("DRS")
  logoUrl       String?
  faviconUrl    String?
  primaryColor  String   @default("#2563EB")
  accentColor   String   @default("#3B82F6")
  defaultFontId String?
  defaultRadius String   @default("0.75rem")
  updatedAt     DateTime @updatedAt

  defaultFont Font? @relation(fields: [defaultFontId], references: [id])
}

model Font {
  id        String   @id @default(cuid())
  name      String   @unique
  family    String // CSS font-family value
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  weights          FontWeight[]
  clinicSettings   ClinicSettings[]
  platformSettings PlatformSettings[]
}

model FontWeight {
  id      String @id @default(cuid())
  fontId  String
  weight  Int // 400, 500, 600, 700
  fileUrl String // URL to WOFF2 file
  format  String @default("woff2")

  font Font @relation(fields: [fontId], references: [id], onDelete: Cascade)

  @@unique([fontId, weight])
}

// ===== ERP & CRM ADVANCED MODELS (ADDED IN PHASE 2) =====

enum InvoiceStatus {
  DRAFT
  UNPAID
  PARTIAL
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  INSURANCE
  INSTALLMENT
}

enum ExpenseCategory {
  SALARIES
  RENT
  SUPPLIES
  UTILITIES
  MARKETING
  MAINTENANCE
  OTHER
}

enum StockTransactionType {
  IN
  OUT
  ADJUSTMENT
}

// 1. EMR & CLINICAL RECORDS

model MedicalHistory {
  id              String   @id @default(cuid())
  patientId       String   @unique
  allergies       String?  @db.Text
  chronicDiseases String?  @db.Text
  medications     String?  @db.Text
  bloodType       String?
  notes           String?  @db.Text
  updatedAt       DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model DentalRecord {
  id          String   @id @default(cuid())
  patientId   String
  toothNumber Int // FDI system: 11-18, 21-28, 31-38, 41-48
  condition   String // e.g., "DECAYED", "FILLED", "MISSING", "CROWNED"
  notes       String?  @db.Text
  updatedAt   DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, toothNumber])
}

model Prescription {
  id            String   @id @default(cuid())
  clinicId      String
  patientId     String
  doctorId      String
  appointmentId String?
  medications   Json // Array of { name, dosage, frequency, duration, notes }
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clinic      Clinic       @relation("ClinicPrescriptions", fields: [clinicId], references: [id], onDelete: Cascade)
  patient     Patient      @relation("PatientPrescriptions", fields: [patientId], references: [id], onDelete: Cascade)
  doctor      Doctor       @relation("DoctorPrescriptions", fields: [doctorId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([clinicId])
  @@index([patientId])
}

// 2. FINANCIALS & BILLING (ERP)

model Invoice {
  id            String        @id @default(cuid())
  clinicId      String
  patientId     String
  appointmentId String?
  invoiceNumber String        @unique
  subtotal      Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  tax           Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  status        InvoiceStatus @default(UNPAID)
  dueDate       DateTime?     @db.Date
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  clinic      Clinic        @relation("ClinicInvoices", fields: [clinicId], references: [id], onDelete: Cascade)
  patient     Patient       @relation("PatientInvoices", fields: [patientId], references: [id], onDelete: Cascade)
  appointment Appointment?  @relation(fields: [appointmentId], references: [id])
  items       InvoiceItem[]
  payments    Payment[]

  @@index([clinicId])
  @@index([patientId])
  @@index([status])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  serviceId   String?
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)
  toothNumber Int? // If linked to a specific tooth

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

model Payment {
  id            String        @id @default(cuid())
  clinicId      String
  invoiceId     String
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  referenceCode String?
  paymentDate   DateTime      @default(now())
  notes         String?       @db.Text

  clinic  Clinic  @relation("ClinicPayments", fields: [clinicId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@index([invoiceId])
}

model Expense {
  id          String          @id @default(cuid())
  clinicId    String
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(10, 2)
  description String
  expenseDate DateTime        @db.Date
  receiptUrl  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  clinic Clinic @relation("ClinicExpenses", fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@index([category])
}

// 3. INVENTORY & SUPPLY CHAIN

model InventoryItem {
  id          String   @id @default(cuid())
  clinicId    String
  name        String
  sku         String?
  category    String?
  quantity    Int      @default(0)
  unit        String // e.g., "Box", "Piece", "ml"
  minQuantity Int      @default(5)
  costPrice   Decimal? @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clinic       Clinic             @relation("ClinicInventory", fields: [clinicId], references: [id], onDelete: Cascade)
  transactions StockTransaction[]

  @@index([clinicId])
}

model StockTransaction {
  id              String               @id @default(cuid())
  inventoryItemId String
  type            StockTransactionType
  quantity        Int
  notes           String?
  createdAt       DateTime             @default(now())
  createdByUserId String?

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([inventoryItemId])
}

// 4. CRM & PATIENT ENGAGEMENT

model Lead {
  id        String   @id @default(cuid())
  clinicId  String
  fullName  String
  phone     String
  source    String? // e.g., "Facebook", "Website", "Referral"
  status    String   @default("NEW") // NEW, CONTACTED, CONVERTED, LOST
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic Clinic @relation("ClinicLeads", fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId])
}
