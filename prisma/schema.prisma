generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===== ENUMS =====

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ClinicStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
  DELETED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum DomainType {
  PLATFORM_SUBDOMAIN
  CUSTOM_DOMAIN
}

enum DomainStatus {
  PENDING
  VERIFICATION_REQUIRED
  VERIFIED
  ACTIVE
  FAILED
  SUSPENDED
  REMOVED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
}

enum WebsiteSectionType {
  HERO
  ABOUT
  SERVICES
  DOCTORS
  WHY_CHOOSE_US
  GALLERY
  TESTIMONIALS
  FAQ
  CONTACT
  BOOKING
}

enum AuditAction {
  LOGIN
  LOGOUT
  SIGNUP
  CLINIC_CREATED
  CLINIC_UPDATED
  CLINIC_SUSPENDED
  CLINIC_REACTIVATED
  CLINIC_DELETED
  ADMIN_CLINIC_ACCESS
  ADMIN_CLINIC_EXIT
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  ROLE_CHANGED
  PASSWORD_CHANGED
  PASSWORD_RESET
  EMAIL_VERIFIED
  DOMAIN_ADDED
  DOMAIN_REMOVED
  DOMAIN_VERIFIED
  SUBSCRIPTION_CHANGED
  SETTINGS_UPDATED
  WEBSITE_UPDATED
  WEBSITE_PUBLISHED
}

// ===== USER & AUTH MODELS =====

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  emailVerified   Boolean    @default(false)
  passwordHash    String
  fullName        String
  phone           String?
  avatarUrl       String?
  isAdmin         Boolean    @default(false)
  isSuperAdmin    Boolean    @default(false)
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sessions            Session[]
  memberships          ClinicMembership[]
  auditLogs            AuditLog[]        @relation("AuditActor")
  verificationTokens   VerificationToken[]
  passwordResetTokens  PasswordResetToken[]

  @@index([email])
  @@index([status])
}

model Session {
  id        String   @id  // SHA-256 hash of session token
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  // Admin tenant access
  adminAccessClinicId  String?
  adminAccessStartedAt DateTime?
  adminAccessExpiresAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model VerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique  // SHA-256 hash
  userId    String
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique  // SHA-256 hash
  userId    String
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
}

// ===== CLINIC & MULTI-TENANCY =====

model Clinic {
  id          String       @id @default(cuid())
  name        String       // Arabic name
  slug        String       @unique  // English slug for subdomain
  status      ClinicStatus @default(ACTIVE)
  timezone    String       @default("Africa/Cairo")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  settings     ClinicSettings?
  memberships  ClinicMembership[]
  roles        Role[]         @relation("ClinicRoles")
  doctors      Doctor[]
  patients     Patient[]
  appointments Appointment[]
  services     Service[]
  website      Website?
  domains      Domain[]
  subscription Subscription?
  auditLogs    AuditLog[]
  mediaAssets  MediaAsset[]

  @@index([slug])
  @@index([status])
}

model ClinicSettings {
  id              String  @id @default(cuid())
  clinicId        String  @unique
  logoUrl         String?
  faviconUrl      String?
  primaryColor    String  @default("#2563EB")
  secondaryColor  String  @default("#1E40AF")
  accentColor     String  @default("#3B82F6")
  fontId          String?
  phone           String?
  email           String?
  address         String?
  city            String?
  country         String  @default("EG")
  socialFacebook  String?
  socialInstagram String?
  socialTwitter   String?
  socialWhatsapp  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  font   Font?  @relation(fields: [fontId], references: [id])
}

model ClinicMembership {
  id        String           @id @default(cuid())
  userId    String
  clinicId  String
  roleId    String
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, clinicId])
  @@index([clinicId])
  @@index([userId])
}

// ===== RBAC =====

model Role {
  id        String   @id @default(cuid())
  name      String
  nameAr    String
  clinicId  String?  // null = system default role
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic      Clinic?          @relation("ClinicRoles", fields: [clinicId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships ClinicMembership[]

  @@unique([name, clinicId])
  @@index([clinicId])
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique  // e.g. "patients.view"
  description String?
  descriptionAr String?
  category    String  // e.g. "patients"

  roles RolePermission[]

  @@index([category])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ===== CLINIC BUSINESS MODELS =====

model Doctor {
  id           String   @id @default(cuid())
  clinicId     String
  fullName     String
  specialty    String?
  bio          String?
  photoUrl     String?
  phone        String?
  email        String?
  isActive     Boolean  @default(true)
  showOnWebsite Boolean @default(true)
  sortOrder    Int      @default(0)
  workingHours Json?    // { "sunday": {"start": "09:00", "end": "17:00"}, ... }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  services     DoctorService[]

  @@index([clinicId])
  @@index([clinicId, isActive])
}

model Patient {
  id           String   @id @default(cuid())
  clinicId     String
  fullName     String
  phone        String?
  email        String?
  dateOfBirth  DateTime?
  gender       Gender?
  address      String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([clinicId])
  @@index([clinicId, fullName])
  @@index([clinicId, phone])
}

model Service {
  id            String   @id @default(cuid())
  clinicId      String
  name          String
  nameEn        String?
  description   String?
  price         Decimal? @db.Decimal(10, 2)
  duration      Int?     // minutes
  imageUrl      String?
  isActive      Boolean  @default(true)
  showOnWebsite Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clinic       Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  doctors      DoctorService[]

  @@index([clinicId])
  @@index([clinicId, isActive])
}

model DoctorService {
  doctorId  String
  serviceId String

  doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([doctorId, serviceId])
}

model Appointment {
  id        String            @id @default(cuid())
  clinicId  String
  patientId String
  doctorId  String
  serviceId String?
  date      DateTime          @db.Date
  startTime String            // "09:00" format
  endTime   String?           // "09:30" format
  status    AppointmentStatus @default(SCHEDULED)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id])

  @@index([clinicId, date])
  @@index([clinicId, status])
  @@index([clinicId, doctorId, date])
  @@index([clinicId, patientId])
}

// ===== WEBSITE =====

model Website {
  id        String  @id @default(cuid())
  clinicId  String  @unique
  themeId   String?
  isPublished Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic   Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  theme    WebsiteTheme?   @relation(fields: [themeId], references: [id])
  sections WebsiteSection[]
  settings WebsiteSettings?
}

model WebsiteSection {
  id        String             @id @default(cuid())
  websiteId String
  type      WebsiteSectionType
  title     String?
  titleEn   String?
  content   Json?              // Section-specific content
  isEnabled Boolean            @default(true)
  sortOrder Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, sortOrder])
}

model WebsiteTheme {
  id          String   @id @default(cuid())
  name        String
  nameAr      String
  slug        String   @unique
  description String?
  previewUrl  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  websites Website[]
}

model WebsiteSettings {
  id              String  @id @default(cuid())
  websiteId       String  @unique
  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?
  canonicalDomain String?
  customCss       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
}

// ===== DOMAINS =====

model Domain {
  id         String       @id @default(cuid())
  clinicId   String
  domain     String       @unique
  type       DomainType
  status     DomainStatus @default(PENDING)
  isPrimary  Boolean      @default(false)
  verifiedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([domain])
  @@index([clinicId])
}

// ===== MEDIA =====

model MediaAsset {
  id        String   @id @default(cuid())
  clinicId  String
  fileName  String
  fileUrl   String
  fileSize  Int
  mimeType  String
  category  String   // logo, doctor, service, gallery, website
  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@index([clinicId, category])
}

// ===== SUBSCRIPTIONS =====

model Plan {
  id           String   @id @default(cuid())
  name         String
  nameAr       String
  slug         String   @unique
  description  String?
  priceMonthly Decimal? @db.Decimal(10, 2)
  priceYearly  Decimal? @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  features      PlanFeature[]
  subscriptions Subscription[]
}

model PlanFeature {
  id      String  @id @default(cuid())
  planId  String
  key     String  // e.g. "website.custom_domain", "team.max_users"
  value   String  // "true", "5", "unlimited"

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
}

model Subscription {
  id        String             @id @default(cuid())
  clinicId  String             @unique
  planId    String
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @default(now())
  endDate   DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([clinicId])
  @@index([status])
}

// ===== AUDIT =====

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  clinicId   String?
  action     AuditAction
  resource   String?     // e.g. "patient", "appointment"
  resourceId String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  actor  User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  @@index([clinicId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

// ===== PLATFORM SETTINGS =====

model PlatformSettings {
  id             String  @id @default(cuid())
  platformName   String  @default("DRS")
  logoUrl        String?
  faviconUrl     String?
  primaryColor   String  @default("#2563EB")
  accentColor    String  @default("#3B82F6")
  defaultFontId  String?
  defaultRadius  String  @default("0.75rem")
  updatedAt      DateTime @updatedAt

  defaultFont Font? @relation(fields: [defaultFontId], references: [id])
}

model Font {
  id        String   @id @default(cuid())
  name      String   @unique
  family    String   // CSS font-family value
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  weights         FontWeight[]
  clinicSettings  ClinicSettings[]
  platformSettings PlatformSettings[]
}

model FontWeight {
  id       String @id @default(cuid())
  fontId   String
  weight   Int    // 400, 500, 600, 700
  fileUrl  String // URL to WOFF2 file
  format   String @default("woff2")

  font Font @relation(fields: [fontId], references: [id], onDelete: Cascade)

  @@unique([fontId, weight])
}
